{
  "name": "conciliado",
  "version": "1.0.0",
  "description": "Design tokens for the Conciliado app. Source of truth: tokens.css and tailwind.tokens.js are generated from this file by scripts/brand-tokens.ts. Read docs/design-system.md for how each token is used.",
  "color": {
    "light": {
      "paper": "#FAF8F3",
      "surface": "#FFFFFF",
      "sunken": "#F1EEE6",
      "line": "#D9D4C7",
      "line-strong": "#85806F",
      "ink": "#1C2030",
      "ink-muted": "#4A4F5E",
      "ink-subtle": "#5F6474",
      "accent": "#2A3F8F",
      "accent-hover": "#1F3078",
      "accent-ink": "#FFFFFF",
      "accent-wash": "#E6EAF6",
      "final": "#14653F",
      "final-wash": "#E1F1E8",
      "pending": "#7A4E00",
      "pending-wash": "#FBEED3",
      "danger": "#A12525",
      "danger-wash": "#FBE4E1",
      "mainnet": "#1C2030",
      "mainnet-ink": "#FAF8F3",
      "focus": "#2A3F8F"
    },
    "dark": {
      "paper": "#12141C",
      "surface": "#1A1D28",
      "sunken": "#0E1016",
      "line": "#2D3243",
      "line-strong": "#7B829E",
      "ink": "#ECE9E1",
      "ink-muted": "#B9B7B0",
      "ink-subtle": "#9C9EA9",
      "accent": "#9DB0FF",
      "accent-hover": "#B5C3FF",
      "accent-ink": "#0E1330",
      "accent-wash": "#222B52",
      "final": "#6FD39A",
      "final-wash": "#133222",
      "pending": "#F0C060",
      "pending-wash": "#35290D",
      "danger": "#FF9F98",
      "danger-wash": "#3C1917",
      "mainnet": "#ECE9E1",
      "mainnet-ink": "#12141C",
      "focus": "#9DB0FF"
    }
  },
  "contrast": [
    { "fg": "ink", "bg": "paper", "min": 4.5, "use": "body text on the page" },
    { "fg": "ink", "bg": "surface", "min": 4.5, "use": "text in tables and cards" },
    { "fg": "ink", "bg": "sunken", "min": 4.5, "use": "text on table headers and zebra rows" },
    { "fg": "ink-muted", "bg": "paper", "min": 4.5, "use": "secondary text on the page" },
    { "fg": "ink-muted", "bg": "surface", "min": 4.5, "use": "secondary text in tables and cards" },
    { "fg": "ink-muted", "bg": "sunken", "min": 4.5, "use": "column headers" },
    { "fg": "ink-subtle", "bg": "paper", "min": 4.5, "use": "hints and captions on the page" },
    { "fg": "ink-subtle", "bg": "surface", "min": 4.5, "use": "hints and captions in cards" },
    { "fg": "ink-subtle", "bg": "sunken", "min": 4.5, "use": "hints on table headers" },
    { "fg": "accent", "bg": "paper", "min": 4.5, "use": "links on the page" },
    { "fg": "accent", "bg": "surface", "min": 4.5, "use": "links in cards and tables" },
    { "fg": "accent", "bg": "accent-wash", "min": 4.5, "use": "selected row and tinted chip text" },
    { "fg": "accent-ink", "bg": "accent", "min": 4.5, "use": "primary button label" },
    { "fg": "accent-ink", "bg": "accent-hover", "min": 4.5, "use": "primary button label on hover" },
    { "fg": "final", "bg": "final-wash", "min": 4.5, "use": "final pill, matched row, tie-out at zero" },
    { "fg": "final", "bg": "surface", "min": 4.5, "use": "final text on a card" },
    { "fg": "pending", "bg": "pending-wash", "min": 4.5, "use": "pending pill, warning row, testnet badge" },
    { "fg": "pending", "bg": "surface", "min": 4.5, "use": "pending text on a card" },
    { "fg": "danger", "bg": "danger-wash", "min": 4.5, "use": "error row, tie-out difference not zero" },
    { "fg": "danger", "bg": "surface", "min": 4.5, "use": "error text on a card" },
    { "fg": "mainnet-ink", "bg": "mainnet", "min": 4.5, "use": "mainnet badge" },
    { "fg": "line-strong", "bg": "paper", "min": 3, "use": "input and button borders on the page (non-text)" },
    { "fg": "line-strong", "bg": "surface", "min": 3, "use": "input borders on cards (non-text)" },
    { "fg": "focus", "bg": "paper", "min": 3, "use": "focus ring on the page (non-text)" },
    { "fg": "focus", "bg": "surface", "min": 3, "use": "focus ring on cards (non-text)" },
    { "fg": "focus", "bg": "sunken", "min": 3, "use": "focus ring on table headers (non-text)" }
  ],
  "font": {
    "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
  },
  "fontSize": {
    "xs": { "size": "0.75rem", "lineHeight": "1rem", "weight": 500, "tracking": "0.02em" },
    "sm": { "size": "0.875rem", "lineHeight": "1.25rem", "weight": 400, "tracking": "0" },
    "base": { "size": "1rem", "lineHeight": "1.5rem", "weight": 400, "tracking": "0" },
    "lg": { "size": "1.125rem", "lineHeight": "1.75rem", "weight": 500, "tracking": "0" },
    "xl": { "size": "1.25rem", "lineHeight": "1.75rem", "weight": 600, "tracking": "-0.005em" },
    "2xl": { "size": "1.5rem", "lineHeight": "2rem", "weight": 600, "tracking": "-0.01em" },
    "3xl": { "size": "1.875rem", "lineHeight": "2.25rem", "weight": 600, "tracking": "-0.015em" },
    "4xl": { "size": "2.5rem", "lineHeight": "2.75rem", "weight": 700, "tracking": "-0.02em" }
  },
  "spacing": {
    "0": "0",
    "px": "1px",
    "0.5": "0.125rem",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.375rem",
    "lg": "0.625rem",
    "full": "9999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "strong": "2px"
  },
  "shadow": {
    "light": {
      "raised": "0 1px 2px rgb(28 32 48 / 0.08), 0 1px 1px rgb(28 32 48 / 0.04)",
      "overlay": "0 8px 24px rgb(28 32 48 / 0.14), 0 2px 6px rgb(28 32 48 / 0.08)"
    },
    "dark": {
      "raised": "0 0 0 1px rgb(236 233 225 / 0.04)",
      "overlay": "0 8px 24px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(236 233 225 / 0.06)"
    }
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "360ms"
    },
    "easing": {
      "out": "cubic-bezier(0.2, 0, 0, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },
  "breakpoint": {
    "sm": "40rem",
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem"
  },
  "layout": {
    "touchTarget": "2.75rem",
    "readingMax": "40rem",
    "contentMax": "72rem",
    "pageGutter": "1rem",
    "pageGutterLg": "2rem"
  }
}
